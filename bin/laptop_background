#!/bin/bash

WALLPAPERS=("" "TDSOTM.png" "Pinkerton.jpg" "KidA.jpg" "Insomniac.jpg" "Sonic.png")
PREV=0

handle() {
  case $1 in
    workspacev2*)
        ID=$(hyprctl activeworkspace -j | jq '.id')
        IMG="/home/ashi/Pictures/Wallpapers/${WALLPAPERS[$ID]}"
        DIRECTION=center
        if (( $ID > $PREV )); then
            DIRECTION=right
        else
            DIRECTION=left
        fi
        awww img $IMG --transition-fps 60 --transition-duration 0.6 --transition-type $DIRECTION --transition-bezier 0.23,1,0.32,1
        PREV=$ID
        ;;
  esac
}

socat -U - UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock | while read -r line; do handle "$line"; done & disown

sleep 0.1; kitten panel --edge=background -o background_opacity=0.7 cava
